{
  "name": "nomad-dimension",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted documentary production pipeline for YouTube (JS/Netlify/Notion).",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "netlify dev",
    "graph:index": "npx gitnexus@latest analyze --max-file-size 1024 --skip-agents-md",
    "deploy:stage": "node scripts/build-deploy.mjs",
    "deploy:preview": "npm run deploy:stage && netlify deploy --dir=_deploy --functions=functions --context production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"functions/**/*.test.js\" \"scripts/**/*.test.js\"",
    "check:html": "node scripts/check-html-syntax.mjs",
    "check": "npm run lint && npm run format:check && npm run check:html && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3"
  }
}
