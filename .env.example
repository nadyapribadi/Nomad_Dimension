# Copy to .env for local `netlify dev`. Never commit .env.
# In production these are set in the Netlify dashboard
# (Site settings -> Environment variables), not here.

ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=
OPENAI_API_KEY=
GOOGLE_TTS_API_KEY=
YOUTUBE_API_KEY=
NOTION_TOKEN=

# Optional. Fallback for functions/yt-transcript.js when the free caption
# scrape is blocked. youtube-transcript.io token (free tier ~25/mo).
TRANSCRIPT_API_KEY=

# Optional. Google Places API (New) key for functions/maps-proxy.js — enriches
# extracted places with prefecture / lat-lng / address. Unset = the app keeps
# the AI's prefecture guess. Enable "Places API (New)" in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Optional extra LLM providers (OpenAI-compatible adapter in
# functions/_shared/models.js). Set only the ones you route to.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
